<Application x:Class="Snit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Snit.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Styles.xaml pulls in Colors.xaml itself. -->
                <ResourceDictionary Source="/Snit;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Small helpers used in bindings. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:EqualsConverter x:Key="EqualsConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
