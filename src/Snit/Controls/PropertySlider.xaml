<!--
    One row in the inspector: a label, a slider and the value as text.
    Example: <controls:PropertySlider Label="Scale" Minimum="0" Maximum="400" Value="100" Format="{}{0:0}%"/>
-->
<UserControl x:Class="Snit.Controls.PropertySlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Margin="0,3">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="62"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>

        <Slider Grid.Column="1"
                Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"/>

        <TextBlock Grid.Column="2" Text="{Binding DisplayText, ElementName=Root}"
                   Style="{StaticResource TimecodeText}" FontSize="11"
                   HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
