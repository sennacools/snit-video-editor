<!--
    Snit's colour palette and fonts.
    Every colour in the app comes from here, so changing a value here changes it everywhere.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E0F11"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1A1B1F"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#16171A"/>
    <SolidColorBrush x:Key="TimelineBrush" Color="#16171A"/>
    <SolidColorBrush x:Key="MonitorBrush" Color="#111214"/>
    <SolidColorBrush x:Key="InputBrush" Color="#111214"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2C31"/>
    <SolidColorBrush x:Key="RowDividerBrush" Color="#222428"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#E6E7EA"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9CBD0"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9A9DA5"/>

    <!-- Accent (buttons, sliders, selection) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#78AEFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A86E6"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#2A5B9BFF"/>

    <!-- Buttons and inputs (small steps lighter than the panels) -->
    <SolidColorBrush x:Key="ControlBrush" Color="#222429"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2A2C32"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#32353C"/>

    <!-- Playhead and current timecode -->
    <SolidColorBrush x:Key="PlayheadBrush" Color="#FF7A45"/>

    <!-- Clips -->
    <SolidColorBrush x:Key="VideoClipBrush" Color="#3B5BA9"/>
    <SolidColorBrush x:Key="VideoClipBorderBrush" Color="#5A78C2"/>
    <SolidColorBrush x:Key="SelectedClipBorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextClipBrush" Color="#7A4FB5"/>
    <SolidColorBrush x:Key="TextClipBorderBrush" Color="#9670C9"/>
    <SolidColorBrush x:Key="AudioClipBrush" Color="#24614A"/>
    <SolidColorBrush x:Key="AudioClipBorderBrush" Color="#3A8466"/>
    <SolidColorBrush x:Key="WaveformBrush" Color="#7FD1A8"/>

    <!-- Audio meters -->
    <SolidColorBrush x:Key="MeterGreenBrush" Color="#3FB57A"/>
    <SolidColorBrush x:Key="MeterYellowBrush" Color="#E8C547"/>

    <!-- Window close button hover (standard Windows red) -->
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E81123"/>

    <!--
        Fonts. WPF tries each name in order, so if Inter or JetBrains Mono
        is not installed it quietly falls back to Segoe UI / Consolas.
    -->
    <FontFamily x:Key="UiFont">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Consolas</FontFamily>
    <!-- Built-in Windows icon font (Windows 11 name first, Windows 10 name second). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
