<!-- Inspector (right panel): settings of the selected clip. -->
<UserControl x:Class="Snit.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Snit.Controls">
    <Border Style="{StaticResource PanelBorder}">
        <DockPanel>
            <!-- Which clip is selected -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,0,1"
                    Padding="14,10">
                <StackPanel>
                    <TextBlock Text="SELECTED CLIP" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Inspector.ClipName}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,0,14,14">
                    <!-- ===== Text: only shown when a title is selected ===== -->
                    <StackPanel Visibility="{Binding Inspector.HasTitle, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="TEXT" Style="{StaticResource SectionTitle}"/>
                        <TextBox Text="{Binding Inspector.TitleText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="120"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 ToolTip="Press Enter for a new line"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Inspector.Fonts}"
                                      SelectedItem="{Binding Inspector.TitleFont}" MaxDropDownHeight="300">
                                <ComboBox.ItemsPanel>
                                    <!-- Only creates the font rows you scroll to, so the long list opens quickly. -->
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <controls:PropertySlider Label="Size" Minimum="12" Maximum="300" Margin="0,8,0,3"
                                                 Value="{Binding Inspector.TitleSize}" Format="{}{0:0} px"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Colour" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding Inspector.ColorChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="20" Height="20" Margin="0,0,5,5" Padding="0" ToolTip="{Binding}"
                                                    Background="{Binding}" BorderBrush="{StaticResource BorderBrush}"
                                                    Command="{Binding DataContext.Inspector.SetTitleColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Inspector.TitleColor, UpdateSourceTrigger=LostFocus}" Width="90"
                                         HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}"
                                         ToolTip="Any colour as #RRGGBB"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="86,10,0,0">
                            <CheckBox Content="Bold" IsChecked="{Binding Inspector.TitleBold}"/>
                            <CheckBox Content="Shadow" Margin="16,0,0,0" IsChecked="{Binding Inspector.TitleShadow}"/>
                            <CheckBox Content="Box" Margin="16,0,0,0" IsChecked="{Binding Inspector.TitleBox}"
                                      ToolTip="A see-through dark box behind the text"/>
                        </StackPanel>

                        <controls:PropertySlider Label="Position X" Minimum="0" Maximum="100" Margin="0,10,0,3"
                                                 Value="{Binding Inspector.TitleX}" Format="{}{0:0}%"/>
                        <controls:PropertySlider Label="Position Y" Minimum="0" Maximum="100"
                                                 Value="{Binding Inspector.TitleY}" Format="{}{0:0}%"/>
                    </StackPanel>

                    <!-- ===== Picture: transform and colour of the selected clip (or of the video linked to a selected sound) ===== -->
                    <StackPanel IsEnabled="{Binding Inspector.HasVisual}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reset" Padding="8,2" FontSize="11" VerticalAlignment="Bottom"
                                    Margin="0,0,0,4" Command="{Binding Inspector.ResetLookCommand}"
                                    ToolTip="Put size, rotation, opacity, position and colour back to normal"/>
                            <TextBlock Text="TRANSFORM" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyframeButton}"
                                    Content="{Binding Inspector.Keys[Scale].Glyph}" ToolTip="{Binding Inspector.Keys[Scale].ToolTip}"
                                    Tag="{Binding Inspector.Keys[Scale].IsAnimated}"
                                    Command="{Binding Inspector.ToggleKeyframeCommand}" CommandParameter="Scale"/>
                            <controls:PropertySlider Label="Scale" Minimum="0" Maximum="400"
                                                     Value="{Binding Inspector.Scale}" Format="{}{0:0}%"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyframeButton}"
                                    Content="{Binding Inspector.Keys[Rotation].Glyph}" ToolTip="{Binding Inspector.Keys[Rotation].ToolTip}"
                                    Tag="{Binding Inspector.Keys[Rotation].IsAnimated}"
                                    Command="{Binding Inspector.ToggleKeyframeCommand}" CommandParameter="Rotation"/>
                            <controls:PropertySlider Label="Rotation" Minimum="-180" Maximum="180"
                                                     Value="{Binding Inspector.Rotation}" Format="{}{0:0}°"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyframeButton}"
                                    Content="{Binding Inspector.Keys[Opacity].Glyph}" ToolTip="{Binding Inspector.Keys[Opacity].ToolTip}"
                                    Tag="{Binding Inspector.Keys[Opacity].IsAnimated}"
                                    Command="{Binding Inspector.ToggleKeyframeCommand}" CommandParameter="Opacity"/>
                            <controls:PropertySlider Label="Opacity" Minimum="0" Maximum="100"
                                                     Value="{Binding Inspector.Opacity}" Format="{}{0:0}%"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyframeButton}"
                                    Content="{Binding Inspector.Keys[PositionX].Glyph}" ToolTip="{Binding Inspector.Keys[PositionX].ToolTip}"
                                    Tag="{Binding Inspector.Keys[PositionX].IsAnimated}"
                                    Command="{Binding Inspector.ToggleKeyframeCommand}" CommandParameter="PositionX"/>
                            <controls:PropertySlider Label="Position X" Minimum="-1920" Maximum="1920"
                                                     Value="{Binding Inspector.PositionX}" Format="{}{0:0} px"/>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource KeyframeButton}"
                                    Content="{Binding Inspector.Keys[PositionY].Glyph}" ToolTip="{Binding Inspector.Keys[PositionY].ToolTip}"
                                    Tag="{Binding Inspector.Keys[PositionY].IsAnimated}"
                                    Command="{Binding Inspector.ToggleKeyframeCommand}" CommandParameter="PositionY"/>
                            <controls:PropertySlider Label="Position Y" Minimum="-1080" Maximum="1080"
                                                     Value="{Binding Inspector.PositionY}" Format="{}{0:0} px"/>
                        </DockPanel>

                        <TextBlock Text="COLOR" Style="{StaticResource SectionTitle}"/>
                        <controls:PropertySlider Label="Exposure" Minimum="-3" Maximum="3"
                                                 Value="{Binding Inspector.Exposure}" Format="{}{0:+0.0;-0.0;0.0}"/>
                        <controls:PropertySlider Label="Contrast" Minimum="-100" Maximum="100"
                                                 Value="{Binding Inspector.Contrast}" Format="{}{0:+0;-0;0}"/>
                        <controls:PropertySlider Label="Saturation" Minimum="0" Maximum="200"
                                                 Value="{Binding Inspector.Saturation}" Format="{}{0:0}%"/>
                        <controls:PropertySlider Label="Temperature" Minimum="-100" Maximum="100"
                                                 Value="{Binding Inspector.Temperature}" Format="{}{0:+0;-0;0}"/>
                    </StackPanel>

                    <!-- ===== Effects of the selected clip, top to bottom ===== -->
                    <StackPanel Visibility="{Binding Inspector.HasEffects, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="EFFECTS" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Inspector.EffectRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10,6,6,8" CornerRadius="6" Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                                        Width="24" Height="24" Command="{Binding RemoveCommand}" ToolTip="Remove this effect"/>
                                                <CheckBox IsChecked="{Binding Enabled}" ToolTip="Switch the effect on or off">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                </CheckBox>
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <controls:PropertySlider Label="{Binding Label}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                                     Value="{Binding Value}" Format="{Binding Format}"
                                                                                     Visibility="{Binding IsSlider, Converter={StaticResource BoolToVisibility}}"/>
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,4"
                                                                      Visibility="{Binding IsSwitch, Converter={StaticResource BoolToVisibility}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Green screen: which colour to remove -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding NeedsColor, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Colour" Width="86" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <Button Width="20" Height="20" Padding="0" Margin="0,0,5,0" Background="#00FF00" ToolTip="Green"
                                                        Command="{Binding SetColorCommand}" CommandParameter="#00FF00"/>
                                                <Button Width="20" Height="20" Padding="0" Margin="0,0,8,0" Background="#0000FF" ToolTip="Blue"
                                                        Command="{Binding SetColorCommand}" CommandParameter="#0000FF"/>
                                                <TextBox Text="{Binding Color, UpdateSourceTrigger=LostFocus}" Width="84"
                                                         FontFamily="{StaticResource MonoFont}" ToolTip="Any colour as #RRGGBB"/>
                                            </StackPanel>
                                            <!-- LUT: which file -->
                                            <DockPanel Margin="0,6,0,0" Visibility="{Binding NeedsFile, Converter={StaticResource BoolToVisibility}}">
                                                <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseFileCommand}"/>
                                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sound of the selected clip (or of the sound linked to a selected video). -->
                    <StackPanel IsEnabled="{Binding Inspector.HasAudio}">
                        <TextBlock Text="AUDIO" Style="{StaticResource SectionTitle}"/>
                        <controls:PropertySlider Label="Volume" Minimum="-60" Maximum="12"
                                                 Value="{Binding Inspector.VolumeDb}" Format="{}{0:+0.0;-0.0;0.0} dB"/>
                        <controls:PropertySlider Label="Fade in" Minimum="0" Maximum="{Binding Inspector.FadeMaximum}"
                                                 Value="{Binding Inspector.FadeInSeconds}" Format="{}{0:0.0} s"/>
                        <controls:PropertySlider Label="Fade out" Minimum="0" Maximum="{Binding Inspector.FadeMaximum}"
                                                 Value="{Binding Inspector.FadeOutSeconds}" Format="{}{0:0.0} s"/>
                    </StackPanel>

                    <!-- ===== Transitions at the start and end of the selected clip ===== -->
                    <StackPanel IsEnabled="{Binding Inspector.HasClip}">
                        <TextBlock Text="TRANSITIONS" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="At start" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Inspector.TransitionChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding Inspector.StartKind}"/>
                            <controls:PropertySlider Grid.Row="1" Grid.ColumnSpan="2" Label="Length" Minimum="0.1"
                                                     Maximum="{Binding Inspector.TransitionMaximum}"
                                                     Value="{Binding Inspector.StartSeconds}" Format="{}{0:0.0} s" Margin="0,4,0,8"/>
                            <TextBlock Grid.Row="2" Text="At end" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Inspector.TransitionChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding Inspector.EndKind}"/>
                            <controls:PropertySlider Grid.Row="3" Grid.ColumnSpan="2" Label="Length" Minimum="0.1"
                                                     Maximum="{Binding Inspector.TransitionMaximum}"
                                                     Value="{Binding Inspector.EndSeconds}" Format="{}{0:0.0} s" Margin="0,4,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== Speed (video and sound; the linked partner follows) ===== -->
                    <StackPanel IsEnabled="{Binding Inspector.HasSpeed}">
                        <TextBlock Text="SPEED" Style="{StaticResource SectionTitle}"/>
                        <controls:PropertySlider Label="Speed" Minimum="10" Maximum="400"
                                                 Value="{Binding Inspector.SpeedPercent}" Format="{}{0:0}%"/>
                        <CheckBox Content="Reverse" Margin="0,8,0,0" IsChecked="{Binding Inspector.Reverse}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="The clip gets shorter or longer; the clips after it slide along. Reversed clips play choppy in the preview but export smoothly."/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
