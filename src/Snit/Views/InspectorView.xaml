<!-- Inspector (right panel): settings of the selected clip. -->
<UserControl x:Class="Snit.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Snit.Controls">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <DockPanel>
            <!-- Which clip is selected -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,0,1"
                    Padding="14,10">
                <StackPanel>
                    <TextBlock Text="SELECTED CLIP" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Timeline.SelectedClipName}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- Greyed out until these effects exist (phases 4 and 5). -->
                <StackPanel Margin="14,0,14,14" IsEnabled="False">
                    <TextBlock Text="TRANSFORM" Style="{StaticResource SectionTitle}"/>
                    <controls:PropertySlider Label="Scale" Minimum="0" Maximum="400" Value="100" Format="{}{0:0}%"/>
                    <controls:PropertySlider Label="Rotation" Minimum="-180" Maximum="180" Value="0" Format="{}{0:0}°"/>
                    <controls:PropertySlider Label="Opacity" Minimum="0" Maximum="100" Value="100" Format="{}{0:0}%"/>
                    <controls:PropertySlider Label="Position X" Minimum="-1920" Maximum="1920" Value="0" Format="{}{0:0} px"/>
                    <controls:PropertySlider Label="Position Y" Minimum="-1080" Maximum="1080" Value="0" Format="{}{0:0} px"/>

                    <TextBlock Text="COLOR" Style="{StaticResource SectionTitle}"/>
                    <controls:PropertySlider Label="Exposure" Minimum="-3" Maximum="3" Value="0" Format="{}{0:+0.0;-0.0;0.0}"/>
                    <controls:PropertySlider Label="Contrast" Minimum="-100" Maximum="100" Value="0" Format="{}{0:+0;-0;0}"/>
                    <controls:PropertySlider Label="Saturation" Minimum="0" Maximum="200" Value="100" Format="{}{0:0}%"/>
                    <controls:PropertySlider Label="Temperature" Minimum="-100" Maximum="100" Value="0" Format="{}{0:+0;-0;0}"/>

                    <TextBlock Text="AUDIO" Style="{StaticResource SectionTitle}"/>
                    <controls:PropertySlider Label="Volume" Minimum="-60" Maximum="12" Value="0" Format="{}{0:+0.0;-0.0;0.0} dB"/>
                    <controls:PropertySlider Label="Fade in" Minimum="0" Maximum="5" Value="0" Format="{}{0:0.0} s"/>
                    <controls:PropertySlider Label="Fade out" Minimum="0" Maximum="5" Value="0" Format="{}{0:0.0} s"/>

                    <TextBlock Text="SPEED" Style="{StaticResource SectionTitle}"/>
                    <controls:PropertySlider Label="Speed" Minimum="10" Maximum="400" Value="100" Format="{}{0:0}%"/>
                    <CheckBox Content="Reverse" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
