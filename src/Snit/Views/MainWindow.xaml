<!--
    The main window. It draws its own dark title bar (instead of the white Windows one),
    then three panels on top (media bin, program monitor, inspector) and the timeline below.
-->
<Window x:Class="Snit.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Snit.Views"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <!-- WindowChrome removes the standard title bar but keeps resizing, snapping and dragging. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>    <!-- title / menu bar -->
            <RowDefinition Height="Auto"/>  <!-- "FFmpeg missing" bar (only when needed) -->
            <RowDefinition Height="520*"/>  <!-- media bin, monitor, inspector -->
            <RowDefinition Height="4"/>     <!-- drag handle -->
            <RowDefinition Height="336*"/>  <!-- timeline -->
        </Grid.RowDefinitions>

        <!-- ============ Title / menu bar ============ -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- logo -->
                    <ColumnDefinition Width="Auto"/> <!-- menus -->
                    <ColumnDefinition Width="*"/>    <!-- empty space you can drag the window by -->
                    <ColumnDefinition Width="Auto"/> <!-- workspace switcher -->
                    <ColumnDefinition Width="Auto"/> <!-- export -->
                    <ColumnDefinition Width="Auto"/> <!-- window buttons -->
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8C6;" Style="{StaticResource IconText}" FontSize="16"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Snit" FontSize="14" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menus. Items that are not built yet are greyed out. -->
                <Menu Grid.Column="1">
                    <MenuItem Header="_File">
                        <MenuItem Header="New project" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}"/>
                        <MenuItem Header="Open project…" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}"/>
                        <MenuItem Header="Open recent" ItemsSource="{Binding RecentProjects}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding}"/>
                                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                        <MenuItem Header="Save as…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                        <Separator/>
                        <MenuItem Header="Import media…" InputGestureText="Ctrl+I" Command="{Binding Bin.ImportCommand}"/>
                        <MenuItem Header="Export…" InputGestureText="Ctrl+M" Command="{Binding ExportCommand}"/>
                        <Separator/>
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding Timeline.UndoCommand}"/>
                        <MenuItem Header="Redo" InputGestureText="Ctrl+Shift+Z" Command="{Binding Timeline.RedoCommand}"/>
                        <Separator/>
                        <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="{Binding Timeline.CutCommand}"/>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding Timeline.CopyCommand}"/>
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding Timeline.PasteCommand}"/>
                        <Separator/>
                        <MenuItem Header="Delete" InputGestureText="Del" Command="{Binding Timeline.DeleteSelectionCommand}"/>
                        <MenuItem Header="Ripple delete" InputGestureText="Shift+Del" Command="{Binding Timeline.RippleDeleteSelectionCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Clip">
                        <MenuItem Header="Split at playhead" InputGestureText="Ctrl+K" Command="{Binding Timeline.SplitAtPlayheadCommand}"/>
                        <MenuItem Header="Cross dissolve at playhead cut" InputGestureText="Ctrl+D" Command="{Binding Timeline.AddDissolveAtPlayheadCommand}"/>
                        <Separator/>
                        <MenuItem Header="Nest selected clips…" Click="Nest_Click"/>

                    </MenuItem>
                    <MenuItem Header="_Timeline">
                        <MenuItem Header="Play / pause" InputGestureText="Space" Command="{Binding PlayPauseCommand}"/>
                        <MenuItem Header="Go to start" InputGestureText="Home" Command="{Binding GoToStartCommand}"/>
                        <MenuItem Header="Go to end" InputGestureText="End" Command="{Binding GoToEndCommand}"/>
                        <MenuItem Header="Previous cut" InputGestureText="↑" Click="PreviousEdit_Click"/>
                        <MenuItem Header="Next cut" InputGestureText="↓" Click="NextEdit_Click"/>
                        <Separator/>
                        <MenuItem Header="Add marker" InputGestureText="M" Command="{Binding Timeline.AddMarkerCommand}"/>
                        <MenuItem Header="Next marker" InputGestureText="Shift+M" Click="NextMarker_Click"/>
                        <MenuItem Header="Previous marker" InputGestureText="Ctrl+Shift+M" Click="PreviousMarker_Click"/>
                        <Separator/>
                        <MenuItem Header="Mark in" InputGestureText="I" Click="MarkIn_Click"/>
                        <MenuItem Header="Mark out" InputGestureText="O" Click="MarkOut_Click"/>
                        <MenuItem Header="Clear in and out" InputGestureText="Ctrl+Shift+X" Click="ClearInOut_Click"/>
                        <Separator/>
                        <MenuItem Header="Snapping" IsCheckable="True" InputGestureText="S" IsChecked="{Binding Timeline.SnappingEnabled}"/>
                        <Separator/>
                        <MenuItem Header="New sequence…" Click="NewSequence_Click"/>
                        <MenuItem Header="Rename sequence…" Click="RenameSequence_Click"/>
                        <MenuItem Header="Delete sequence" Click="DeleteSequence_Click"/>
                        <MenuItem Header="Sequence settings…" Click="SequenceSettings_Click"/>
                        <Separator/>
                        <MenuItem Header="Add caption at playhead" Command="{Binding Timeline.AddCaptionAtPlayheadCommand}"/>
                        <MenuItem Header="Import captions (.srt)…" Click="ImportCaptions_Click"/>
                        <MenuItem Header="Export captions (.srt)…" Click="ExportCaptions_Click"/>
                        <Separator/>
                        <MenuItem Header="Add video track" Command="{Binding Timeline.AddVideoTrackCommand}"/>
                        <MenuItem Header="Add audio track" Command="{Binding Timeline.AddAudioTrackCommand}"/>
                        <Separator/>
                        <MenuItem Header="Zoom in" InputGestureText="=" Command="{Binding Timeline.ZoomInCommand}"/>
                        <MenuItem Header="Zoom out" InputGestureText="-" Command="{Binding Timeline.ZoomOutCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="Title-safe guides" IsCheckable="True"
                                  IsChecked="{Binding ShowSafeGuides}"/>
                        <MenuItem Header="Use proxies for preview" IsCheckable="True" IsChecked="{Binding UseProxies}"
                                  ToolTip="Big videos play from their small copies. Make them by right-clicking a video in the bin."/>
                        <MenuItem Header="Make proxies for all videos" Command="{Binding Bin.CreateAllProxiesCommand}"/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="Check FFmpeg" Command="{Binding ReportFfmpegStatusCommand}"/>
                        <Separator/>
                        <MenuItem Header="About Snit" Command="{Binding ShowAboutCommand}"/>
                    </MenuItem>
                </Menu>

                <!-- Workspace switcher -->
                <Border Grid.Column="3" Background="{StaticResource InputBrush}" CornerRadius="6" Padding="2"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Edit"
                                     IsChecked="{Binding Workspace, Converter={StaticResource EqualsConverter}, ConverterParameter=Edit}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Color"
                                     IsChecked="{Binding Workspace, Converter={StaticResource EqualsConverter}, ConverterParameter=Color}"/>
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Audio"
                                     IsChecked="{Binding Workspace, Converter={StaticResource EqualsConverter}, ConverterParameter=Audio}"/>
                    </StackPanel>
                </Border>

                <!-- Export -->
                <Button Grid.Column="4" Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                        VerticalAlignment="Center" Command="{Binding ExportCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTipService.ShowOnDisabled="True" ToolTip="Export the timeline as a video (Ctrl+M)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>

                <!-- Minimise / maximise / close -->
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimise"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="Maximise"/>
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>

                <!-- Project info, centred over the whole bar. Clicks go through to the bar so you can still drag. -->
                <TextBlock Grid.ColumnSpan="6" Text="{Binding ProjectInfo}" ToolTip="{Binding AutoSaveStatus}"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ============ "FFmpeg is missing" bar ============ -->
        <Border Grid.Row="1" Background="#1C2433" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                Margin="4,4,4,0" Padding="14,8"
                Visibility="{Binding IsFfmpegBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="16"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="FFmpeg isn't installed." FontWeight="SemiBold"/>
                    <Run Text="Snit needs it to import and export video. Install it by running" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <Run Text="{Binding FfmpegInstallCommand, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                         Foreground="{StaticResource TextBrush}"/>
                    <Run Text="in a terminal, then click Check again." Foreground="{StaticResource SecondaryTextBrush}"/>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Copy command" Command="{Binding CopyFfmpegInstallCommandCommand}" Margin="0,0,6,0"/>
                    <Button Content="Check again" Command="{Binding CheckFfmpegCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11"
                            Command="{Binding DismissFfmpegBannerCommand}" ToolTip="Hide this message"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Upper area: media bin | monitor | inspector ============ -->
        <Grid Grid.Row="2" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <views:MediaBinView Grid.Column="0"
                                Visibility="{Binding Workspace, Converter={StaticResource WorkspaceVisibility}, ConverterParameter=Edit}"/>
            <views:ScopesView Grid.Column="0"
                              Visibility="{Binding Workspace, Converter={StaticResource WorkspaceVisibility}, ConverterParameter=Color}"/>
            <views:MixerView Grid.Column="0"
                             Visibility="{Binding Workspace, Converter={StaticResource WorkspaceVisibility}, ConverterParameter=Audio}"/>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Cursor="SizeWE"/>
            <views:ProgramMonitorView x:Name="Monitor" Grid.Column="2"/>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" Cursor="SizeWE"/>
            <views:InspectorView Grid.Column="4"
                                 Visibility="{Binding Workspace, Converter={StaticResource WorkspaceVisibility}, ConverterParameter=Edit}"/>
            <views:ColorPanelView Grid.Column="4"
                                  Visibility="{Binding Workspace, Converter={StaticResource WorkspaceVisibility}, ConverterParameter=Color}"/>
            <views:AudioPanelView Grid.Column="4"
                                  Visibility="{Binding Workspace, Converter={StaticResource WorkspaceVisibility}, ConverterParameter=Audio}"/>
        </Grid>

        <GridSplitter Grid.Row="3" ResizeDirection="Rows" Cursor="SizeNS"/>

        <!-- ============ Timeline ============ -->
        <views:TimelineView Grid.Row="4" Margin="4,0,4,4"/>
    </Grid>
</Window>
