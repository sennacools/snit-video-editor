<!-- Media bin (left panel): tabs, search, Import, and a grid of thumbnails you can drag to the timeline. -->
<UserControl x:Class="Snit.Views.MediaBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Snit.Core">
    <UserControl.Resources>
        <!-- One tile in the bin: thumbnail with a duration badge, name underneath. -->
        <DataTemplate x:Key="MediaTile" DataType="{x:Type core:MediaItem}">
            <StackPanel ToolTip="{Binding FilePath}">
                <Border x:Name="Frame" CornerRadius="5" Background="{StaticResource MonitorBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True"
                        Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource SixteenByNine}}">
                    <Grid>
                        <!-- Placeholder icon (audio files, or while the thumbnail loads) -->
                        <TextBlock x:Name="Icon" Text="&#xE714;" Style="{StaticResource IconText}" FontSize="20"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        <Border Background="#CC0E0F11" CornerRadius="3" Padding="5,1" Margin="4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" Foreground="{StaticResource TextBrush}"/>
                        </Border>
                        <!-- "P" badge: this video has a proxy. -->
                        <Border Background="#CC5B9BFF" CornerRadius="3" Padding="4,1" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" ToolTip="Has a proxy for smooth preview"
                                Visibility="{Binding HasProxy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="P" FontSize="10" FontWeight="Bold" Foreground="#0B1220"/>
                        </Border>
                        <Border Background="#B0000000" Visibility="{Binding IsMakingProxy, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Making proxy…" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Offline" Background="#B0200000" Visibility="Collapsed">
                            <TextBlock Text="File missing" Foreground="White" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Name}" Margin="1,5,1,0" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAudioOnly}" Value="True">
                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource AudioClipBrush}"/>
                    <Setter TargetName="Icon" Property="Text" Value="&#xE8D6;"/>
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource WaveformBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                    <Setter TargetName="Offline" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Plain list item: no Windows-blue highlight, the tile shows selection itself. -->
        <Style x:Key="TileContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}">
        <DockPanel>
            <!-- Tabs -->
            <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="6,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabButton}" Content="Media"
                                 IsChecked="{Binding Bin.ActiveTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Media}"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Effects"
                                 IsChecked="{Binding Bin.ActiveTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Effects}"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Transitions"
                                 IsChecked="{Binding Bin.ActiveTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Transitions}"/>
                    <RadioButton Style="{StaticResource TabButton}" Content="Text"
                                 IsChecked="{Binding Bin.ActiveTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Text}"/>
                </StackPanel>
            </Border>

            <Grid>
                <!-- ===== Media tab ===== -->
                <DockPanel x:Name="MediaTab" AllowDrop="True" Drop="MediaTab_Drop" DragOver="MediaTab_DragOver" Background="Transparent">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Media">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </DockPanel.Style>

                    <!-- Search + Import -->
                    <Grid DockPanel.Dock="Top" Margin="10,10,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Tag="Search media" Text="{Binding Bin.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding Bin.ImportCommand}" ToolTip="Import media (Ctrl+I)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="Import"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Bin.ImportStatus}" Style="{StaticResource MutedText}"
                               Margin="12,0,12,8"/>

                    <Grid>
                        <!-- Thumbnails, two per row -->
                        <ListBox x:Name="MediaList" ItemsSource="{Binding Bin.Items}"
                                 SelectedItem="{Binding Bin.SelectedItem}"
                                 ItemTemplate="{StaticResource MediaTile}" ItemContainerStyle="{StaticResource TileContainer}"
                                 Background="Transparent" BorderThickness="0" Padding="5,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="MediaList_PreviewMouseMove"
                                 KeyDown="MediaList_KeyDown"
                                 MouseDoubleClick="MediaList_DoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Make proxy (smooth preview)" Command="{Binding Bin.CreateProxyCommand}"/>
                                    <MenuItem Header="Make proxies for all videos" Command="{Binding Bin.CreateAllProxiesCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Remove from project" InputGestureText="Del"
                                              Command="{Binding Bin.RemoveCommand}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>

                        <!-- Shown when the bin is empty -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding Bin.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE714;" Style="{StaticResource IconText}" FontSize="28"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="No media yet" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Click Import or drop files here, then drag them onto the timeline."
                                       Style="{StaticResource MutedText}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- ===== Text tab: titles ===== -->
                <StackPanel Margin="10,12,10,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Text">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Ready-made titles: drag one onto a video track (like a media file), or double-click for the playhead. -->
                    <ItemsControl ItemsSource="{x:Static core:TitleTemplates.All}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="112" Margin="0,0,8,10" Cursor="Hand" Background="Transparent" Tag="{Binding}"
                                        ToolTip="Drag onto a video track, or double-click to add it at the playhead"
                                        PreviewMouseLeftButtonDown="TitleTile_MouseDown" PreviewMouseMove="TitleTile_MouseMove">
                                    <StackPanel>
                                        <Border CornerRadius="5" Height="63" ClipToBounds="True"
                                                BorderBrush="{StaticResource TextClipBorderBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3A4A5E" Offset="0"/>
                                                    <GradientStop Color="#1D2633" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Image Source="{Binding Style, Converter={StaticResource TitlePreview}}" Stretch="Fill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Margin="1,5,1,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Or pick the T tool under the timeline and click on a video track. Change the text, font and colour in the inspector on the right."/>
                </StackPanel>

                <!-- ===== Effects tab ===== -->
                <DockPanel Margin="10,12,10,0">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Effects">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,10"
                               Text="Drag an effect onto a clip on a video track, or double-click it to add it to the selected clip. Change or remove it in the inspector."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Static core:EffectCatalog.All}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Tag="{Binding Kind}" Margin="0,0,0,6" Padding="10,8" CornerRadius="5" Cursor="Hand"
                                            Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            PreviewMouseLeftButtonDown="EffectTile_MouseDown" PreviewMouseMove="EffectTile_MouseMove"
                                            MouseLeftButtonUp="EffectTile_MouseUp">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Transitions tab ===== -->
                <StackPanel Margin="10,12,10,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Transitions">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <UniformGrid Columns="2">
                        <!-- Tag says which transition the tile drags. -->
                        <Border Tag="CrossDissolve" Margin="0,0,5,0" Cursor="Hand" Background="Transparent"
                                ToolTip="Drag onto the start or end of a clip, or onto a cut between two clips"
                                PreviewMouseLeftButtonDown="TransitionTile_MouseDown" PreviewMouseMove="TransitionTile_MouseMove">
                            <StackPanel>
                                <Border CornerRadius="5" Height="70" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3B5BA9" Offset="0.15"/>
                                            <GradientStop Color="#7A4FB5" Offset="0.85"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Cross dissolve" Margin="1,5,1,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Tag="DipToBlack" Margin="5,0,0,0" Cursor="Hand" Background="Transparent"
                                ToolTip="Drag onto the start or end of a clip, or onto a cut between two clips"
                                PreviewMouseLeftButtonDown="TransitionTile_MouseDown" PreviewMouseMove="TransitionTile_MouseMove">
                            <StackPanel>
                                <Border CornerRadius="5" Height="70" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3B5BA9" Offset="0.05"/>
                                            <GradientStop Color="#000000" Offset="0.5"/>
                                            <GradientStop Color="#7A4FB5" Offset="0.95"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Dip to black" Margin="1,5,1,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Button Content="Cross dissolve at playhead cut" HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding Timeline.AddDissolveAtPlayheadCommand}" ToolTip="Ctrl+D"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="A cross dissolve between two clips uses a little extra footage from beyond the cut, if the files have it. Change the length or remove it in the inspector."/>
                </StackPanel>

                <!-- ===== Other tabs (not built yet) ===== -->
                <TextBlock Text="Coming in a later phase."
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Media">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Text">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Transitions">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Bin.ActiveTab}" Value="Effects">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
