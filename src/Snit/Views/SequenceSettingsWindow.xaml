<!-- Timeline → Sequence settings: the video size and frame rate of the sequence. -->
<Window x:Class="Snit.Views.SequenceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="444" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="12">
    <Border Margin="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Sequence settings" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="10"/>
                    <RowDefinition/>
                    <RowDefinition Height="10"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Size" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="Presets" Grid.Column="1" SelectionChanged="Presets_SelectionChanged"/>

                <TextBlock Grid.Row="2" Text="Width × height" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="WidthBox" Width="80" TextChanged="Size_TextChanged" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="HeightBox" Width="80" TextChanged="Size_TextChanged" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Text="pixels" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Frame rate" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="Rates" Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left"/>
            </Grid>

            <TextBlock x:Name="Note" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Text="Clips keep their place in time. Changing these settings clears the undo history."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="OK" MinWidth="80" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
