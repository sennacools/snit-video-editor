<!-- A small "type a name" dialog (renaming markers, and later sequences). -->
<Window x:Class="Snit.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="12">
    <Border Margin="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Question" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBox x:Name="Answer"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="OK" MinWidth="80" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
