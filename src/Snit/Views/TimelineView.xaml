<!--
    Timeline (bottom): tool column, header row, track headers (V2, V1, A1, A2),
    time ruler, the track area (TimelineCanvas) and audio meters on the right.
-->
<UserControl x:Class="Snit.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Snit.Controls"
             xmlns:core="clr-namespace:Snit.Core"
             xmlns:vm="clr-namespace:Snit.ViewModels">
    <UserControl.Resources>
        <Style x:Key="MeterScaleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <!-- One track header: name, hide/mute toggle, lock toggle. Height matches TimelineCanvas.TrackHeight. -->
        <DataTemplate x:Key="TrackHeader" DataType="{x:Type core:Track}">
            <Border x:Name="Row" Height="56" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,1,1" Padding="12,0,8,0"
                    Tag="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <!-- Right-click a track header. (The menu reaches the timeline through Tag, because
                     a context menu lives outside the window's tree.) -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add video track" Command="{Binding PlacementTarget.Tag.AddVideoTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Add audio track" Command="{Binding PlacementTarget.Tag.AddAudioTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Delete this track" Command="{Binding PlacementTarget.Tag.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ToggleButton x:Name="OffToggle" Style="{StaticResource TrackToggle}" Content="&#xE890;"
                                      ToolTip="Hide track" IsChecked="{Binding IsOff}"/>
                        <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE72E;"
                                      ToolTip="Lock track" IsChecked="{Binding IsLocked}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:TrackKind.Audio}">
                    <Setter TargetName="OffToggle" Property="Content" Value="&#xE767;"/>
                    <Setter TargetName="OffToggle" Property="ToolTip" Value="Mute track"/>
                </DataTrigger>
                <!-- thicker line under V1: separates video from audio -->
                <DataTrigger Binding="{Binding Name}" Value="V1">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0,0,1,2"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}" Background="{StaticResource TimelineBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>   <!-- tools -->
                <ColumnDefinition Width="132"/>  <!-- track headers -->
                <ColumnDefinition Width="*"/>    <!-- ruler + tracks -->
                <ColumnDefinition Width="56"/>   <!-- audio meters -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>     <!-- header row -->
                <RowDefinition Height="28"/>     <!-- ruler -->
                <RowDefinition Height="*"/>      <!-- tracks -->
                <RowDefinition Height="Auto"/>   <!-- scroll bar -->
            </Grid.RowDefinitions>

            <!-- ============ Tool column ============ -->
            <Border Grid.RowSpan="4" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource ToolButton}" ToolTip="Select (V)"
                                 IsChecked="{Binding Timeline.ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Select}">
                        <!-- mouse pointer arrow -->
                        <Path Data="M0,0 L0,14 L3.6,10.6 L6.2,16.4 L8.4,15.4 L5.9,9.8 L10.8,9.6 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" Content="&#xE8C6;" ToolTip="Razor: click a clip to cut it (C)"
                                 IsChecked="{Binding Timeline.ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Razor}"/>
                    <RadioButton Style="{StaticResource ToolButton}" ToolTip="Ripple trim: drag a clip edge and the clips after it follow (B)"
                                 IsChecked="{Binding Timeline.ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Ripple}">
                        <!-- bracket with arrows: ]⟷[ -->
                        <Path Data="M5,1 L7,1 L7,15 L5,15 M11,1 L9,1 L9,15 L11,15 M0,8 L4,8 M2,6 L0,8 L2,10 M16,8 L12,8 M14,6 L16,8 L14,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.4"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" ToolTip="Text: click on a video track to add a title (T)"
                                 IsChecked="{Binding Timeline.ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Text}">
                        <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontSize="16" FontWeight="Bold"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" Content="&#xE7C2;" ToolTip="Hand: drag to scroll the timeline (H)"
                                 IsChecked="{Binding Timeline.ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Hand}"/>
                    <RadioButton Style="{StaticResource ToolButton}" Content="&#xE71E;" ToolTip="Zoom: click to zoom in, Alt+click to zoom out (Z)"
                                 IsChecked="{Binding Timeline.ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Zoom}"/>
                </StackPanel>
            </Border>

            <!-- ============ Header row ============ -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="{StaticResource PanelBrush}" Padding="12,0">
                <DockPanel>
                    <TextBlock Text="Main sequence" Style="{StaticResource PanelTitleText}"/>
                    <CheckBox Content="Snapping" Margin="20,0,0,0" IsChecked="{Binding Timeline.SnappingEnabled}"
                              ToolTip="Clips snap to the playhead and to other clips' edges (S)"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ V" Padding="8,2" FontSize="11" Margin="0,0,4,0"
                                Command="{Binding Timeline.AddVideoTrackCommand}" ToolTip="Add a video track on top"/>
                        <Button Content="+ A" Padding="8,2" FontSize="11" Margin="0,0,16,0"
                                Command="{Binding Timeline.AddAudioTrackCommand}" ToolTip="Add an audio track at the bottom"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Width="26" Height="26" FontSize="12"
                                Command="{Binding Timeline.ZoomOutCommand}" ToolTip="Zoom out (-)"/>
                        <Slider Width="140" Margin="6,0"
                                Minimum="{x:Static vm:TimelineViewModel.MinPixelsPerSecond}"
                                Maximum="{x:Static vm:TimelineViewModel.MaxPixelsPerSecond}"
                                Value="{Binding Timeline.PixelsPerSecond}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Width="26" Height="26" FontSize="12"
                                Command="{Binding Timeline.ZoomInCommand}" ToolTip="Zoom in (=)"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Ruler row ============ -->
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,1,1" Padding="12,0">
                <TextBlock Text="{Binding Timeline.CurrentTimecode}" Style="{StaticResource TimecodeText}"
                           FontSize="11" Foreground="{StaticResource PlayheadBrush}"/>
            </Border>
            <controls:TimeRuler Grid.Row="1" Grid.Column="2"
                                PixelsPerSecond="{Binding Timeline.PixelsPerSecond}"
                                FramesPerSecond="{Binding Timeline.Fps, Mode=OneWay}"
                                ScrollX="{Binding Timeline.ScrollX}"
                                PlayheadSeconds="{Binding Timeline.PlayheadSeconds}"
                                InSeconds="{Binding Timeline.InSeconds, Mode=OneWay}"
                                OutSeconds="{Binding Timeline.OutSeconds, Mode=OneWay}"
                                RangeBrush="{StaticResource AccentBrush}"
                                Background="{StaticResource PanelBrush}"
                                TickBrush="{StaticResource BorderBrush}"
                                TextBrush="{StaticResource MutedTextBrush}"
                                PlayheadBrush="{StaticResource PlayheadBrush}"
                                ToolTip="Click or drag to move the playhead"/>

            <!-- ============ Track headers and tracks (scroll up/down when there are many tracks) ============ -->
            <ScrollViewer x:Name="TrackScroller" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,1,0">
                        <ItemsControl ItemsSource="{Binding Timeline.Tracks}" ItemTemplate="{StaticResource TrackHeader}"
                                      VerticalAlignment="Top"/>
                    </Border>
                    <controls:TimelineCanvas Grid.Column="1" Timeline="{Binding Timeline}"
                                             MinHeight="{Binding ViewportHeight, ElementName=TrackScroller}"/>
                </Grid>
            </ScrollViewer>

            <!-- ============ Horizontal scroll bar ============ -->
            <ScrollBar Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="0,2"
                       Minimum="0" Maximum="{Binding Timeline.ScrollMaximum, Mode=OneWay}"
                       ViewportSize="{Binding Timeline.ViewportWidth, Mode=OneWay}"
                       Value="{Binding Timeline.ScrollX}"/>

            <!-- ============ Audio meters ============ -->
            <Border Grid.RowSpan="4" Grid.Column="3" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel Margin="0,10,0,8">
                    <TextBlock DockPanel.Dock="Top" Text="L  R" Style="{StaticResource MeterScaleText}"
                               HorizontalAlignment="Center" Margin="0,0,14,4"/>
                    <controls:StereoMeter Left="{Binding LevelLeft}" Right="{Binding LevelRight}"
                                          ToolTip="Sound level while playing (dB)"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
