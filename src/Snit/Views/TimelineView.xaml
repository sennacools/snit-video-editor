<!--
    Timeline (bottom): tool column, header row, track headers (V2, V1, A1, A2),
    time ruler, track lanes with the playhead, and audio meters on the right.
-->
<UserControl x:Class="Snit.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Snit.Controls"
             xmlns:vm="clr-namespace:Snit.ViewModels">
    <UserControl.Resources>
        <!-- Track header: name on the left, toggles on the right. -->
        <Style x:Key="TrackHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RowDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0,8,0"/>
        </Style>
        <Style x:Key="TrackName" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TrackLane" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource RowDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="MeterScaleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelBorder}" Background="{StaticResource TimelineBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>   <!-- tools -->
                <ColumnDefinition Width="132"/>  <!-- track headers -->
                <ColumnDefinition Width="*"/>    <!-- ruler + lanes -->
                <ColumnDefinition Width="56"/>   <!-- audio meters -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>     <!-- header row -->
                <RowDefinition Height="*"/>      <!-- ruler + tracks -->
            </Grid.RowDefinitions>

            <!-- ============ Tool column ============ -->
            <Border Grid.RowSpan="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource ToolButton}" ToolTip="Select (V)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Select}">
                        <!-- mouse pointer arrow -->
                        <Path Data="M0,0 L0,14 L3.6,10.6 L6.2,16.4 L8.4,15.4 L5.9,9.8 L10.8,9.6 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" Content="&#xE8C6;" ToolTip="Razor: cut clips (C)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Razor}"/>
                    <RadioButton Style="{StaticResource ToolButton}" ToolTip="Ripple trim (B)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Ripple}">
                        <!-- bracket with arrows: ]⟷[ -->
                        <Path Data="M5,1 L7,1 L7,15 L5,15 M11,1 L9,1 L9,15 L11,15 M0,8 L4,8 M2,6 L0,8 L2,10 M16,8 L12,8 M14,6 L16,8 L14,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.4"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" ToolTip="Text (T)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Text}">
                        <TextBlock Text="T" FontFamily="{StaticResource UiFont}" FontSize="16" FontWeight="Bold"/>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolButton}" Content="&#xE7C2;" ToolTip="Hand: scroll the timeline (H)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Hand}"/>
                    <RadioButton Style="{StaticResource ToolButton}" Content="&#xE71E;" ToolTip="Zoom (Z)"
                                 IsChecked="{Binding ActiveTool, Converter={StaticResource EqualsConverter}, ConverterParameter=Zoom}"/>
                </StackPanel>
            </Border>

            <!-- ============ Header row ============ -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="{StaticResource PanelBrush}" Padding="12,0">
                <DockPanel>
                    <TextBlock Text="Main sequence" Style="{StaticResource PanelTitleText}"/>
                    <CheckBox Content="Snapping" Margin="20,0,0,0" IsChecked="{Binding SnappingEnabled}"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Width="26" Height="26" FontSize="12"
                                Command="{Binding ZoomOutCommand}" ToolTip="Zoom out"/>
                        <Slider Width="140" Margin="6,0"
                                Minimum="{x:Static vm:MainViewModel.MinPixelsPerSecond}"
                                Maximum="{x:Static vm:MainViewModel.MaxPixelsPerSecond}"
                                Value="{Binding PixelsPerSecond}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Width="26" Height="26" FontSize="12"
                                Command="{Binding ZoomInCommand}" ToolTip="Zoom in"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Track headers + lanes ============ -->
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>  <!-- ruler -->
                    <RowDefinition Height="56"/>  <!-- V2 -->
                    <RowDefinition Height="56"/>  <!-- V1 -->
                    <RowDefinition Height="56"/>  <!-- A1 -->
                    <RowDefinition Height="56"/>  <!-- A2 -->
                    <RowDefinition Height="*"/>   <!-- empty space below -->
                </Grid.RowDefinitions>

                <!-- Corner above the track headers -->
                <Border Style="{StaticResource TrackHeader}" Padding="12,0">
                    <TextBlock Text="{Binding CurrentTimecode}" Style="{StaticResource TimecodeText}"
                               FontSize="11" Foreground="{StaticResource PlayheadBrush}"/>
                </Border>

                <!-- V2 -->
                <Border Grid.Row="1" Style="{StaticResource TrackHeader}">
                    <DockPanel>
                        <TextBlock Text="V2" Style="{StaticResource TrackName}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE890;" ToolTip="Hide track"/>
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE72E;" ToolTip="Lock track"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- V1 (thicker line below: separates video from audio) -->
                <Border Grid.Row="2" Style="{StaticResource TrackHeader}" BorderThickness="0,0,1,2"
                        BorderBrush="{StaticResource BorderBrush}">
                    <DockPanel>
                        <TextBlock Text="V1" Style="{StaticResource TrackName}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE890;" ToolTip="Hide track"/>
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE72E;" ToolTip="Lock track"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- A1 -->
                <Border Grid.Row="3" Style="{StaticResource TrackHeader}">
                    <DockPanel>
                        <TextBlock Text="A1" Style="{StaticResource TrackName}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE767;" ToolTip="Mute track"/>
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE72E;" ToolTip="Lock track"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- A2 -->
                <Border Grid.Row="4" Style="{StaticResource TrackHeader}">
                    <DockPanel>
                        <TextBlock Text="A2" Style="{StaticResource TrackName}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE767;" ToolTip="Mute track"/>
                            <ToggleButton Style="{StaticResource TrackToggle}" Content="&#xE72E;" ToolTip="Lock track"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="5" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,1,0"/>

                <!-- Ruler -->
                <controls:TimeRuler Grid.Column="1"
                                    PixelsPerSecond="{Binding PixelsPerSecond}"
                                    FramesPerSecond="{Binding FrameRate}"
                                    Background="{StaticResource PanelBrush}"
                                    TickBrush="{StaticResource BorderBrush}"
                                    TextBrush="{StaticResource MutedTextBrush}"/>

                <!-- Lanes (clips go here in phase 2) -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TrackLane}"/>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TrackLane}"
                        BorderThickness="0,0,0,2" BorderBrush="{StaticResource BorderBrush}">
                    <TextBlock Text="Drag clips here" Style="{StaticResource MutedText}" Margin="16,0" Opacity="0.7"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TrackLane}"/>
                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TrackLane}"/>

                <!-- Playhead: orange marker on the ruler and a line through all tracks. -->
                <Grid Grid.Column="1" Grid.RowSpan="6" ClipToBounds="True" IsHitTestVisible="False">
                    <Grid HorizontalAlignment="Left" Width="13" Margin="-6,0,0,0">
                        <Grid.RenderTransform>
                            <TranslateTransform X="{Binding PlayheadX}"/>
                        </Grid.RenderTransform>
                        <Rectangle Width="1" Fill="{StaticResource PlayheadBrush}" HorizontalAlignment="Center"/>
                        <Path Data="M0,0 L13,0 L13,9 L6.5,15 L0,9 Z" Fill="{StaticResource PlayheadBrush}"
                              VerticalAlignment="Top" Margin="0,13,0,0"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ Audio meters ============ -->
            <Border Grid.RowSpan="2" Grid.Column="3" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel Margin="0,10,0,10">
                    <TextBlock DockPanel.Dock="Top" Text="L  R" Style="{StaticResource MeterScaleText}"
                               HorizontalAlignment="Center" Margin="0,0,10,8"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <!-- The meter colours, shown faintly while nothing is playing. -->
                            <LinearGradientBrush x:Key="MeterScale" StartPoint="0,0" EndPoint="0,1" Opacity="0.18">
                                <GradientStop Color="#E8C547" Offset="0"/>
                                <GradientStop Color="#E8C547" Offset="0.15"/>
                                <GradientStop Color="#3FB57A" Offset="0.16"/>
                                <GradientStop Color="#3FB57A" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Resources>
                        <Border Background="{StaticResource MonitorBrush}" CornerRadius="2">
                            <Rectangle Fill="{StaticResource MeterScale}" RadiusX="2" RadiusY="2"/>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource MonitorBrush}" CornerRadius="2">
                            <Rectangle Fill="{StaticResource MeterScale}" RadiusX="2" RadiusY="2"/>
                        </Border>
                        <Grid Grid.Column="3" Margin="5,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="0" Style="{StaticResource MeterScaleText}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="-6" Style="{StaticResource MeterScaleText}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="2" Text="-12" Style="{StaticResource MeterScaleText}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="3" Text="-24" Style="{StaticResource MeterScaleText}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="4" Text="-48" Style="{StaticResource MeterScaleText}"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
